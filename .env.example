# ==============================================================================
# Arenosa Hotels S.A.S. - Reservations API environment file
# Copy it to .env and adjust the values. No configuration lives in the code.
# ==============================================================================

# --- HTTP server ------------------------------------------------------------
# Use 0.0.0.0 to accept connections from other machines.
HOST=localhost
PORT=3000

# --- PostgreSQL -------------------------------------------------------------
DB_HOST=localhost
DB_PORT=5432
DB_NAME=reservations_db
DB_USER=arenosa
DB_PASSWORD=arenosa
# true only for development and tests: TypeORM creates/updates the schema.
# Use false once the model is stable in a shared environment.
DB_SYNCHRONIZE=true

# --- Security (RN-04) -------------------------------------------------------
# Comma separated list of valid API keys, one per hotel branch.
API_KEYS=clave-via40, clave-malecon, clave-norte

# --- Authentication (JWT + bcrypt) ------------------------------------------
# Secret used to sign and verify the JWT tokens. Generate your own, for example:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-for-a-random-secret-of-at-least-32-characters
# Lifetime of the tokens issued by POST /auth/login.
JWT_EXPIRES_IN=1h
# Cost factor of the password hash (bcrypt).
BCRYPT_ROUNDS=10
# Initial password of the accounts created by the seed on the first boot.
# Change it before exposing the API.
SEED_USER_PASSWORD=Carnaval2026

# --- End to end tests (npm run test:e2e) -----------------------------------
# The suite boots a disposable PostgreSQL cluster with embedded-postgres.
TEST_PG_PORT=55440
TEST_DB_HOST=127.0.0.1
TEST_DB_NAME=reservations_db_test
TEST_DB_USER=postgres
TEST_DB_PASSWORD=postgres
# Schema management of the disposable test database.
TEST_DB_SYNCHRONIZE=true
TEST_API_KEYS=clave-via40-test, clave-malecon-test

# --- Diagram rendering (npm run diagrams:svg) -------------------------------
# Absolute path to a Chrome/Edge binary. Leave it empty to let Puppeteer use
# the browser it manages.
MERMAID_BROWSER_PATH=
